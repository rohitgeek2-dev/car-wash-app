generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Appointment {
  id        Int      @id @default(autoincrement())
  service   String
  date      DateTime        // IMPORTANT: remove @db.Date
  time      String
  carType   String
  name      String
  email     String
  status    String   @default("Pending")
  createdAt DateTime @default(now())

  @@unique([date, time])
}
